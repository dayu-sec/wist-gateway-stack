name : host_audit_syscall
rule : host/host_audit_syscall
---
schema = read(schema);
agent = read(agent);
ts = read(ts);
seq = read(seq);
family = read(family);
unit = read(unit);
event_id = read(wp_event_id);
now = Now::time() | Time::to_ts_ms;
dev_ip = read(wp_src_ip);
tenant_id = chars(2092453428448002048);
dev_vendor = read(dev_vendor);
dev_name = read(dev_name);
dev_type = read(dev_type);
log_type = read(log_type);
log_desc = read(log_desc);
type = read(type);
msg = read(msg);
arch = read(arch);
syscall = read(syscall);
success = read(success);
exit = read(exit);
a0 = read(a0);
a1 = read(a1);
a2 = read(a2);
a3 = read(a3);
items = read(items);
ppid = read(ppid);
pid = read(pid);
auid = read(auid);
uid = read(uid);
gid = read(gid);
euid = read(euid);
suid = read(suid);
fsuid = read(fsuid);
egid = read(egid);
sgid = read(sgid);
fsgid = read(fsgid);
tty = read(tty);
ses = read(ses);
comm = read(comm);
exe = read(exe);
subj = read(subj);
key = read(key);
