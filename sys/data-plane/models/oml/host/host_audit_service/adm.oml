name : host_audit_service
rule : host/host_audit_service
---
schema = read(schema);
agent = read(agent);
ts = read(ts);
seq = read(seq);
family = read(family);
unit = read(unit);
event_id = read(wp_event_id);
now = Now::time() | Time::to_ts_ms;
dev_ip = read(wp_src_ip);
tenant_id = chars(2092453428448002048);
dev_vendor = read(dev_vendor);
dev_name = read(dev_name);
dev_type = read(dev_type);
log_type = read(log_type);
log_desc = read(log_desc);
type = read(type);
audit_id = read(audit_id);
msg = read(msg);
pid = read(pid);
uid = read(uid);
auid = read(auid);
ses = read(ses);
subj = read(subj);
source_unit = read(source_unit);
comm = read(comm);
exe = read(exe);
hostname = read(hostname);
addr = read(addr);
terminal = read(terminal);
res = read(res);
