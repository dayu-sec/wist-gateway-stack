// HostMetrics 主机指标；同包兼容通用 OBSFACT 事实帧。
#[copy_event_parse(rule: "raw_log/raw_log"), tag(dev_vendor: "Wist Agent", dev_name: "Wist Agent")]
package agent_uplink {

    #[tag(dev_type: "主机指标", log_desc: "Agent 主机指标", log_type: "agent_uplink_metrics_frame")]
    rule agent_uplink_metrics_frame {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(METRICS:),
            // 这里只声明**数组**。`json(...)` 是原生反序列化：标量与嵌套字段（`metric/*`）
            // 自动就位，OML 用 `read(metric/xxx)` 按路径取；但 `values` / `timestamps` 这类
            // 数组不会被自动绑定，必须显式列在这里。
            // 不逐字段列那 24 个标量：同一份字段集在 WPL 和 OML 各维护一遭，
            // 正是 `mount`→`mountpoint` 那次静默漂移的来源。
            json(
                array@values,
                array@timestamps,
            )
        )
    }

    #[tag(dev_type: "主机事实", log_desc: "Agent 主机事实", log_type: "agent_uplink_obs_fact")]
    rule agent_uplink_obs_fact {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(OBSFACT:),
            chars:body\0
        )
    }

    #[tag(dev_type: "主机快照", log_desc: "Agent 数据快照", log_type: "agent_uplink_obs_dsnap")]
    rule agent_uplink_obs_dsnap {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(DSNAP:),
            chars:body\0
        )
    }

    // 一次性调查的完整报告（agentd `investigate` 的 ` IVSREP: ` 帧）。
    // 正文是 `Report::to_uplink_body` 的对象（带 `command_id`，与 ack 靠它 join），
    // 这里**不拆字段**：与事实/快照同一条纪律 —— 数据面只搬契约对象，结构由消费者解析。
    #[tag(dev_type: "调查报告", log_desc: "Agent 一次性调查报告", log_type: "agent_uplink_ivsrep_frame")]
    rule agent_uplink_ivsrep {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(IVSREP:),
            chars:body\0
        )
    }
}
