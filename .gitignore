# 运行时状态 / 本地数据
.run/

# 数据面（wparse 工程 + 运行时数据，体量大）
data-plane/.run
data-plane/data
# 引擎**单实例锁**：引擎自身没有单实例保护，开发态脚本与发布态 entrypoint 靠这把锁互斥
#（同一 work root 只能起一份）。它是运行态产物，不入库。
data-plane/.wparse.lock
# 发布态 wparse 运行态根（WPARSE_RUN_DIR）；开发态的运行态在上面两个
data-plane-run/

# 本地二进制
dev/bin/

# 网关运行时配置/密钥（由 init-gateway.sh 生成，含 admin token / TLS 密钥 / 签名密钥 / store）
configs/gateway/

# ===== gops 生成物 =====
# 变量解析结果（gops sys update / package 生成）
sys/resolved_vars.yml
# 值文件：忽略派生的值文件，保留客户覆盖 values/value.yml（版本化）
values/*
!values/value.yml
# .env 由 gops sys localize 生成（非密钥配置；密钥走 ${SEC_xxx} 不落盘）
.env

# macOS
.DS_Store
.report
.run*
