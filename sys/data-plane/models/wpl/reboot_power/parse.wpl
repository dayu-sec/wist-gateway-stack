// RebootPower 关机与重启。
#[copy_event_parse(rule: "raw_log/raw_log"), tag(dev_vendor: "Wist Agent", dev_type: "主机日志", dev_name: "Wist Agent")]
package reboot_power {
    #[tag(log_desc: "关机与重启日志", log_type: "reboot_power_linux_reboot_power")]
    rule reboot_power_linux_reboot_power {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
                chars@family,
                chars@unit
            ),
            symbol(LOGRAW:),
            chars:raw\0 | f_chars_has(family, RebootPower) | f_chars_has(unit, linux-reboot-power)
        )
    }
}
