name : host_audit_path
rule : host/host_audit_path
---
schema = read(schema);
agent = read(agent);
ts = read(ts);
seq = read(seq);
family = read(family);
unit = read(unit);
event_id = read(wp_event_id);
now = Now::time() | Time::to_ts_ms;
dev_ip = read(wp_src_ip);
tenant_id = chars(2092453428448002048);
dev_vendor = read(dev_vendor);
dev_name = read(dev_name);
dev_type = read(dev_type);
log_type = read(log_type);
log_desc = read(log_desc);
type = read(type);
msg = read(msg);
item = read(item);
name = read(name);
inode = read(inode);
dev = read(dev);
mode = read(mode);
ouid = read(ouid);
ogid = read(ogid);
rdev = read(rdev);
nametype = read(nametype);
cap_fp = read(cap_fp);
cap_fi = read(cap_fi);
cap_fe = read(cap_fe);
cap_fver = read(cap_fver);
cap_frootid = read(cap_frootid);
