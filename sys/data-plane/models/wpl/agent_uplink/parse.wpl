// HostMetrics 主机指标；同包兼容通用 OBSFACT 事实帧。
#[copy_event_parse(rule: "raw_log/raw_log"), tag(dev_vendor: "Wist Agent", dev_name: "Wist Agent")]
package agent_uplink {

    #[tag(dev_type: "主机指标", log_desc: "Agent 主机指标", log_type: "agent_uplink_metrics_frame")]
    rule agent_uplink_metrics_frame {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(METRICS:),
            json(
                // 嵌套路径**不重命名**：`json()` 在没有 `:alias` 时按路径绑定，
                // OML 用 `read(metric/xxx)` 直接取。早先那批 `:metric_xxx` 别名是为
                // 「扁平字段」起的名字 —— 那套扁平字段已无消费者（见 adm.oml 顶部）。
                chars@metric/__name__,
                chars@metric/agent,
                chars@metric/instance,
                chars@metric/kind,
                chars@metric/target_ref,
                chars@metric/resource_ref,
                chars@metric/unit,
                // 序列 label：agentd 发什么名字，这里就原样声明什么
                //（规范 `metrics-data-spec.md` §3 的样例帧用的就是 `instance` / `mountpoint`）。
                chars@metric/disk_role,
                chars@metric/mountpoint,
                chars@metric/fstype,
                chars@metric/device,
                chars@metric/cpu,
                chars@metric/mode,
                chars@metric/state,
                chars@metric/target_kind,
                chars@metric/outcome,
                // 选择类 label（网关下发，闭集 `wist_api::metrics_labels::rules::KEYS`）：
                // WPL 不会自动搬运未声明的键，所以逐键显式列。缺键不会让规则失败（读不到就不写）。
                chars@metric/env,
                chars@metric/cluster,
                chars@metric/app,
                chars@metric/role,
                chars@metric/shard,
                chars@metric/tier,
                chars@metric/region,
                chars@metric/zone,
                array@values,
                array@timestamps,
            )
        )
    }

    #[tag(dev_type: "主机事实", log_desc: "Agent 主机事实", log_type: "agent_uplink_obs_fact")]
    rule agent_uplink_obs_fact {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(OBSFACT:),
            chars:body\0
        )
    }

    #[tag(dev_type: "主机快照", log_desc: "Agent 数据快照", log_type: "agent_uplink_obs_dsnap")]
    rule agent_uplink_obs_dsnap {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(DSNAP:),
            chars:body\0
        )
    }

    // 一次性调查的完整报告（agentd `investigate` 的 ` IVSREP: ` 帧）。
    // 正文是 `Report::to_uplink_body` 的对象（带 `command_id`，与 ack 靠它 join），
    // 这里**不拆字段**：与事实/快照同一条纪律 —— 数据面只搬契约对象，结构由消费者解析。
    #[tag(dev_type: "调查报告", log_desc: "Agent 一次性调查报告", log_type: "agent_uplink_ivsrep_frame")]
    rule agent_uplink_ivsrep {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(IVSREP:),
            chars:body\0
        )
    }
}
