    #[tag(log_desc: "容器服务日志", log_type: "container_workload_service_log")]
    rule container_workload_service_log {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
                chars@family,
                chars@unit
            ),
            symbol(LOGRAW:),
            chars:log\0 | f_chars_has(family, ContainerWorkload) | f_chars_has(unit, linux-container-stdout)
        )
    }
    #[late, tag(log_desc: "容器日志", log_type: "container_workload_container_other")]
