name : agent_discovery_snapshot
rule : agent_uplink/discovery_frame
---

// 原文发现快照（`DSNAP:` 帧）**原样透传**：正文是契约对象
// `ReportDiscoverySnapshot`（kind = report_discovery_snapshot）。
// 与事实帧同一取舍：只拆信封，不拆正文 —— 契约一改不用动两处（WPL + OML）。
// 订阅端（wist-atlas 适配器）按 wist-contracts 解析 `body`。
schema = read(schema) ;
agent_id = read(agent) ;
observed_at = read(ts) ;
seq = read(seq) ;
category = read(log_type) ;
log_desc = read(log_desc) ;
body = read(body) ;
