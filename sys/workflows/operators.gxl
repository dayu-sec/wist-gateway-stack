// 系统运维流程（**本地定义**，不引外部 ops-gxl 模块）。
//
// 由 _gal/work.gxl 的 `mod main : operators` 纳入，gops 以 `gx run <flow>` 调用。
// 约定：GXL 行注释是 //（# 是注解语法 #[...]，不是注释）。
mod operators {

  // 阶段扩展点：`gops sys localize` 写完系统根 .env 之后就执行 `gx run localize`
  // （galaxy-ops >= 1.3.4 / galaxy-flow >= 0.14）。合并后的配置以**环境变量**注入本子进程，
  // 用 $(printenv XXX) 读。每个动作都**幂等**（存在即跳过）——证书/密钥绝不能每次重生成。
  flow localize {
    // 确保安装包投放目录存在（只读挂到网关容器 /packages；容器读不到宿主路径）
    gx.cmd ( "mkdir -p packages" );
    // ③ 备料：Ed25519 签名密钥 / 网关 TLS 证书 / 渲染值 value.json（缺什么补什么）
    gx.cmd ( "./scripts/init-gateway.sh configs/gateway" );
    // ③' 备料：知识库内容包的验签公钥。找到就用（并写进渲染值 —— 它决定 tpl 里
    //     `signing_public_key_file` **那一行**渲不渲染）；找不到就什么都不做（验签关闭）。
    //     必须在 ① 渲染之前：它是渲染的输入。
    //     来源（按序）：env KNOWLEDGE_SIGNING_PUBKEY=<路径>、<栈>/sys/keys/（交付走这条）、
    //     同级 wist-knowledge 仓的 keys/（本地开发）。
    gx.cmd ( "./scripts/init-knowledge-signing.sh configs/gateway" );
    // ①'' 接口层（**现场态**）：对外基址 / 归属单独一份（`wist-gateway-pub.toml`），
    //      按缺补齐、**已存在一律保留**（不随模板重渲）。必须在 ① 之前：网关加载时读两份，
    //      主配置里已经没有 `public_base_url`。
    gx.cmd ( "./scripts/init-gateway-pub.sh identity/gateway/public" );
    // ① 渲染网关运行配置：模板 + value.json → configs/gateway/wist-gateway.toml（依赖 ③）
    gx.tpl (
      tpl  : "./sys/configs/gateway/wist-gateway.toml.tpl",
      dst  : "./configs/gateway/wist-gateway.toml",
      file : "./configs/gateway/wist-gateway.value.json"
    );
    // ①c gwlinkd（网关**宿主侧**常驻）的配置：**分两份**。
    //   先备料主配置的渲染值。
    gx.cmd ( "./scripts/init-gwlinkd.sh configs/gwlinkd" );
    // ①c'' gwlinkd 的**现场态**（现场接线：中心地址 / 本网关在中心侧的标识 / 中心信任锚）：
    //   落在 `identity/gwlinkd/`（`sys-prj.yml: contract` 之下）：不可再生、不进包、必进备份。
    //   **声明 + 值分开**（docker-compose 口径）：
    //     · **声明** `gwlinkd-pub.toml`（只写 `${VAR}` 引用、不含现场值）—— 与其它交付物一样
    //       走 **tpl** 机制渲染（交付物，随版本覆盖；值不在这里，所以重渲动不到现场）；
    //     · **值** 在同目录 `.env`（脚本按缺补齐，永不重渲）。
    gx.tpl (
      tpl  : "./sys/configs/gwlinkd/gwlinkd-pub.toml.tpl",
      dst  : "./identity/gwlinkd/gwlinkd-pub.toml",
      data : "{}"
    );
    gx.cmd ( "./scripts/init-gwlinkd-pub.sh identity/gwlinkd" );
    // ①c gwlinkd 的**主配置**（交付物，只含随部署环境渲染的项）：模板 + value.json → 渲染。
    //   现场接线与一次性接入券在主配置之外（上一步的现场态文件）；gwlinkd 加载时读**两份**。
    gx.tpl (
      tpl  : "./sys/configs/gwlinkd/gwlinkd.toml.tpl",
      dst  : "./configs/gwlinkd/gwlinkd.toml",
      file : "./configs/gwlinkd/gwlinkd.value.json"
    );
    // ② 前端站点 TLS 证书（页面自己的）：web CA + 由它签的叶。
    //     **不再用 `test -f … ||` 挡住** —— 幂等由脚本自己判（缺 / 换了域名 / 与当前 CA 不对应才重签）；
    //     如果这里短路，改了 WEB_DOMAIN 就永远不会重签（叶的 SAN 里没有新域名，浏览器报域名不匹配）。
    //     域名取合并后的值 WEB_DOMAIN；脚本末尾会打印该导入哪份 CA。
    gx.cmd ( "./scripts/init-web-tls.sh $(printenv WEB_DOMAIN) identity/web" );
    // ④ 前端站点配置：备料渲染值（脚本）→ gx.tpl → configs/web/nginx.conf。
    //     渲染值必须走脚本，不能在这里 printf：GXL 字符串**不还原 `\"`**，而 Ubuntu 的 /bin/sh 是
    //     dash（printf 不认 `\"`，会把反斜杠写进文件）→ 非法 JSON → gx.tpl 报 parse json data file。
    //     macOS 上 sh 是 bash（printf 吃掉反斜杠）所以看不出问题。详见脚本头部注释。
    gx.cmd ( "./scripts/init-web-conf.sh $(printenv WEB_DOMAIN)" );
    gx.tpl (
      tpl  : "./sys/configs/web/nginx.conf.tpl",
      dst  : "./configs/web/nginx.conf",
      file : "./configs/web/nginx.value.json"
    );
    // ⑤ 初始知识库内容包（出厂自带）：把 ARTIFACT_HOME + "/" + KNOWLEDGE_PATH 拼出的地址拉到投放目录 packages/。
    //     该目录只读挂给网关的 /packages，界面「知识库」页「本地来源」填 /packages/<文件名> 即可录入
    //     —— 录入 ≠ 生效，还要点激活。
    //
    //     这里有两个 GXL 细节（都踩过）：
    //       · 条件里的 ${VAR} 取的是**流程变量空间**，gops 注入的环境变量不在里面（直接写
    //         `if ${X} != ""` 会 VarMiss）。所以先用 gx.read_cmd 把 env 读进空间再比较 ——
    //         与上面几步用 $(printenv XXX) 是同一个原因。
    //       · gx.download 的 local_file 给目录时必须带路径分隔符（写 "./packages"，不能写裸
    //         "packages"）：裸名的 Path::parent() 是空串，exists() 为假，会直接报
    //         `parent path not exists`。
    //         目录形式会按 URL 文件名落盘，且默认 reuse_cache（存在即跳过）——
    //         URL 里带版本、文件名随版本变，所以升版本不会复用旧包。
    gx.read_cmd ( name: "ARTIFACT_HOME", cmd: "printenv ARTIFACT_HOME || true", silence: "true" );
    gx.read_cmd ( name: "KNOWLEDGE_PATH", cmd: "printenv KNOWLEDGE_PATH || true", silence: "true" );
    if defined(${ARTIFACT_HOME}) && ${ARTIFACT_HOME} != "" && defined(${KNOWLEDGE_PATH}) && ${KNOWLEDGE_PATH} != "" {
      gx.download ( url: "${ARTIFACT_HOME}/${KNOWLEDGE_PATH}", local_file: "./packages" );
    }
    // 解包这一步**始终执行**（不再包在 if 里）—— 就是为了**不静默**：
    //   · URL 空   → 脚本打印跳过并说清后果（网关将**空载**：不产用途建议、不能派活）；
    //   · URL 有但没落盘（不可达 / 被墙）→ 脚本 exit 1 并给出处置（手工放包 / 换可达镜像），
    //     而不是装出一个表面体面、实际什么都不采的网关。
    //     放在 if 外还有一个好处：万一 gx.download 失败被吞，这里也会当场拦住。
    gx.cmd ( "./scripts/install-initial-knowledge.sh" );
    // ⑥' WarpParse 管理面（WarpStation 发布链路）：可写运行根 + admin API token。
    //     容器内绑 0.0.0.0:19090 + TLS，宿主只发布 127.0.0.1；token 落在
    //     data-plane-run/.run/admin_api.token（进不了 sys/data-plane/ 只读种子）。
    gx.cmd ( "./scripts/init-wparse-admin.sh" );
    // ⑥ 宿主侧属主/权限对齐（Linux 专有；macOS/OrbStack 直接跳过）：
    //     网关与数据面**固定以 999:999 运行**（compose 里显式钉死），而 Linux 的 bind 挂载
    //     **不改属主** —— 未对齐会稳定地造成：wparse 写不出 /data/.run 的锁（以 75 无限重启）、
    //     网关读不到私钥 / 密钥文件（拒绝启动）、写不进 store 与日志（500）。
    //     用 `gops sys perms --apply`（gops ≥ 2.7，本栈硬要求）：它从 `docker compose config`
    //     派生「哪些挂载要写、哪些只读」，不需要本仓维护名单。
    //     必须放在 localize **最后**：上面的 download / 解包会在 packages/ 与
    //     configs/gateway/knowledge/ 里新建文件（umask 可能使其对容器不可读）。
    //     还必须在 `docker compose up` **之前**：Docker 会把缺失的挂载源目录建成 root:root，
    //     属主一旦是 root，之后的部署账号就写不动了。
    //     幂等：已对齐时不写盘、也不要任何权限；`gops sys perms --check` 可单独做只读自检。
    gx.cmd ( "gops sys perms --help >/dev/null 2>&1 || { echo '错误：本栈需要 gops >= 2.7（gops sys perms）'; exit 1; }; gops sys perms --apply" );
  }

  // 体检（`gops run diagnose`）：本系统专属的「期望」检查。
  //
  // gops 负责通用事实（容器 / 挂载 / 端口 / 日志），这里只补它**不可能知道**的业务语义：
  // 发布/同步是否只落了一半（clone 有、/data 没有），以及 state 说的版本与克隆 HEAD 是否一致。
  //
  // 契约（galaxy-ops `docs/design/run-diagnose.md` §5/§6）：读 `GOPS_DIAGNOSE_CONTEXT`，
  // 把 `checks[]` 写到 `GOPS_DIAGNOSE_RESULT`。**只读**：不改 /data、不 chmod、不重启。
  // 注意：GXL 里读 gops 注入的环境变量要用 $(printenv X)（`${X}` 取的是流程变量空间）。
  flow diagnose {
    gx.cmd ( "./scripts/diagnose-wparse-drift.sh" );
  }

}
