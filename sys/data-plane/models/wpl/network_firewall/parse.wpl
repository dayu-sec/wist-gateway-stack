// NetworkFirewall 网络与防火墙。
#[copy_event_parse(rule: "raw_log/raw_log"), tag(dev_vendor: "Wist Agent", dev_type: "主机日志", dev_name: "Wist Agent")]
package network_firewall {
    #[tag(log_desc: "网络与防火墙日志", log_type: "network_firewall_nftables_config_line")]
    rule network_firewall_nftables_config_line {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
                chars@family,
                chars@unit
            ),
            symbol(LOGRAW:),
            chars:raw\0 | f_chars_has(family, NetworkFirewall) | f_chars_has(unit, linux-network-firewall)
        )
    }
}
