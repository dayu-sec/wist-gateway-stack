name : journald
rule : service_lifecycle/service_lifecycle_journald
---
// 映射 LOGRAW 中的 journald JSON 正文。
schema = read(schema);
agent = read(agent);
ts = read(ts);
seq = read(seq);
family = read(family);
unit = read(unit);
event_id = read(wp_event_id);
now = Now::time() | Time::to_ts_ms;
dev_ip = read(wp_src_ip);
tenant_id = chars(2092453428448002048);
dev_vendor = read(dev_vendor);
dev_name = read(dev_name);
dev_type = read(dev_type);
log_type = read(log_type);
log_desc = read(log_desc);
uid = read(uid);
gid = read(gid);
selinux_context = read(selinux_context);
machine_id = read(machine_id);
body_host = read(body_host);
systemd_cgroup = read(systemd_cgroup);
cap_effective = read(cap_effective);
monotonic_timestamp = read(monotonic_timestamp);
systemd_unit = read(systemd_unit);
journal_seqnum_id = read(journal_seqnum_id);
process_executable = read(process_executable);
journal_cursor = read(journal_cursor);
process_name = read(process_name);
priority = read(priority);
transport = read(transport);
systemd_slice = read(systemd_slice);
syslog_facility = read(syslog_facility);
boot_id = read(boot_id);
realtime_timestamp = read(realtime_timestamp);
raw = read(raw);
body_program = read(body_program);
runtime_scope = read(runtime_scope);
journal_seqnum = read(journal_seqnum);
process_pid = read(process_pid);
process_cmdline = read(process_cmdline);
systemd_invocation_id = read(systemd_invocation_id);
stream_id = read(stream_id);
source_realtime_timestamp = read(source_realtime_timestamp);
syslog_pid = read(syslog_pid);
audit_session = read(audit_session);
audit_loginuid = read(audit_loginuid);
syslog_timestamp = read(syslog_timestamp);
code_file = read(code_file);
code_function = read(code_function);
code_line = read(code_line);
invocation_id = read(invocation_id);
job_id = read(job_id);
job_result = read(job_result);
job_type = read(job_type);
message_id = read(message_id);
thread_id = read(thread_id);
service_unit = read(service_unit);
