name : host_kernel
rule : host/host_kernel
---
schema = read(schema);
agent = read(agent);
ts = read(ts);
seq = read(seq);
family = read(family);
unit = read(unit);
event_id = read(wp_event_id);
now = Now::time() | Time::to_ts_ms;
dev_ip = read(wp_src_ip);
tenant_id = chars(2092453428448002048);
dev_vendor = read(dev_vendor);
dev_name = read(dev_name);
dev_type = read(dev_type);
log_type = read(log_type);
log_desc = read(log_desc);
transport = read(transport);
kernel_message = read(kernel_message);
log_priority = read(log_priority);
syslog_identifier = read(syslog_identifier);
source_host = read(source_host);
