name : kernel_system_host_audit_sockaddr
rule : kernel_system_host/kernel_system_host_audit_sockaddr
---
schema = read(schema);
agent = read(agent);
ts = read(ts);
seq = read(seq);
family = read(family);
unit = read(unit);
event_id = read(wp_event_id);
now = Now::time() | Time::to_ts_ms;
dev_ip = read(wp_src_ip);
dev_vendor = read(dev_vendor);
dev_name = read(dev_name);
dev_type = read(dev_type);
log_type = read(log_type);
log_desc = read(log_desc);
type = read(type);
msg = read(msg);
saddr = read(saddr);
SADDR = read(SADDR);
