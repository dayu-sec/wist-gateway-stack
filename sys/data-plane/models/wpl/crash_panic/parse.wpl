// CrashPanic 崩溃与 Panic。
#[copy_event_parse(rule: "raw_log/raw_log"), tag(dev_vendor: "Wist Agent", dev_type: "主机日志", dev_name: "Wist Agent")]
package crash_panic {
    #[tag(log_desc: "崩溃与 Panic 日志", log_type: "crash_panic_log")]
    rule crash_panic_log {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
                chars@family,
                chars@unit
            ),
            symbol(LOGRAW:),
            chars:raw\0 | f_chars_has(family, CrashPanic) | f_chars_has(unit, linux-crash-panic)
        )
    }
}
