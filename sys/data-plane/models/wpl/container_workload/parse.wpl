// ContainerWorkload 容器日志。
#[copy_event_parse(rule: "raw_log/raw_log"), tag(dev_vendor: "Wist Agent", dev_type: "容器日志", dev_name: "Wist Agent")]
package container_workload {
    #[tag(log_desc: "Wist Center Web 容器日志", log_type: "container_workload_wist_center_web")]
    rule container_workload_wist_center_web {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
                chars@family,
                chars@unit,
                chars@container/name:container_name,
                chars@container/image:container_image,
                chars@container/id:container_id
            ),
            symbol(LOGRAW:),
            json(
                chars@log,
                chars@stream,
                chars@time
            ) | f_chars_has(family, ContainerWorkload) | f_chars_has(unit, linux-docker-container-stdout) | f_chars_has(container_name, wist-center-stack-web)
        )
    }
    #[tag(log_desc: "Wist Gateway Web 容器日志", log_type: "container_workload_wist_gateway_web")]
    rule container_workload_wist_gateway_web {
