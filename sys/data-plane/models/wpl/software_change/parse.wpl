// SoftwareChange 软件变更。
#[copy_event_parse(rule: "raw_log/raw_log"), tag(dev_vendor: "Wist Agent", dev_type: "主机日志", dev_name: "Wist Agent")]
package software_change {
    #[tag(log_desc: "软件变更日志", log_type: "software_change_log")]
    rule software_change_log {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
                chars@family,
                chars@unit
            ),
            symbol(LOGRAW:),
            chars:raw\0 | f_chars_has(family, SoftwareChange) | f_chars_has(unit, linux-software-change)
        )
    }
}
