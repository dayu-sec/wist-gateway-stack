// HostMetrics 主机指标；同包兼容通用 OBSFACT 事实帧。
#[copy_event_parse(rule: "raw_log/raw_log"), tag(dev_vendor: "Wist Agent", dev_name: "Wist Agent")]
package agent_uplink {

    #[tag(dev_type: "主机指标", log_desc: "Agent 主机指标", log_type: "agent_uplink_metrics_frame")]
    rule agent_uplink_metrics_frame {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(METRICS:),
            json(
                chars@metric/__name__:metric_name,
                chars@metric/agent:metric_agent,
                chars@metric/instance:metric_instance,
                chars@metric/kind:metric_kind,
                chars@metric/target_ref:metric_target_ref,
                chars@metric/resource_ref:metric_resource_ref,
                chars@metric/unit:metric_unit,
                // 序列 label：agentd 发什么名字，这里就原样搬什么（不重命名）——
                // 规范 `metrics-data-spec.md` §3 的样例帧用的就是 `instance` / `mountpoint`。
                chars@metric/disk_role:metric_disk_role,
                chars@metric/mountpoint:metric_mountpoint,
                chars@metric/fstype:metric_fstype,
                chars@metric/device:metric_device,
                chars@metric/cpu:metric_cpu,
                chars@metric/mode:metric_mode,
                chars@metric/state:metric_state,
                chars@metric/target_kind:metric_target_kind,
                chars@metric/outcome:metric_outcome,
                // 选择类 label（网关下发，闭集 `wist_api::metrics_labels::rules::KEYS`）：
                // WPL 不会自动搬运未声明的键，所以逐键显式列。缺键不会让规则失败（读不到就不写）。
                chars@metric/env:metric_env,
                chars@metric/cluster:metric_cluster,
                chars@metric/app:metric_app,
                chars@metric/role:metric_role,
                chars@metric/shard:metric_shard,
                chars@metric/tier:metric_tier,
                chars@metric/region:metric_region,
                chars@metric/zone:metric_zone,
                array@values:metric_values,
                array@timestamps:metric_timestamps,
            )
        )
    }

    #[tag(dev_type: "主机事实", log_desc: "Agent 主机事实", log_type: "agent_uplink_obs_fact")]
    rule agent_uplink_obs_fact {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(OBSFACT:),
            chars:body\0
        )
    }

    #[tag(dev_type: "主机快照", log_desc: "Agent 数据快照", log_type: "agent_uplink_obs_dsnap")]
    rule agent_uplink_obs_dsnap {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(DSNAP:),
            chars:body\0
        )
    }

    // 一次性调查的完整报告（agentd `investigate` 的 ` IVSREP: ` 帧）。
    // 正文是 `Report::to_uplink_body` 的对象（带 `command_id`，与 ack 靠它 join），
    // 这里**不拆字段**：与事实/快照同一条纪律 —— 数据面只搬契约对象，结构由消费者解析。
    #[tag(dev_type: "调查报告", log_desc: "Agent 一次性调查报告", log_type: "agent_uplink_ivsrep_frame")]
    rule agent_uplink_ivsrep {
        (
            json(
                chars@schema,
                chars@agent,
                chars@ts,
                digit@seq,
            ),
            symbol(IVSREP:),
            chars:body\0
        )
    }
}
