# 运行时状态 / 本地数据
.run/

# 数据面（wparse 工程 + 运行时数据，体量大）
sys/data-plane/.run
sys/data-plane/data
# 引擎**单实例锁**（<work-root>/.run/.wparse.lock，已在上面 sys/data-plane/.run 内）：
# 引擎自身没有单实例保护，开发态脚本与发布态 entrypoint 靠这把锁互斥（同一 work root 只能起一份）。
# 发布态 wparse 运行态根（WPARSE_RUN_DATA / WPARSE_RUN_STATE）；开发态的运行态在上面两个
data-plane-run/

# 本地二进制
dev/bin/

# 网关/前端**运行期**配置与密钥（现场生成；含 admin token / TLS 私钥 / 签名密钥 / store / 证书）
# 声明文件（web/nginx.conf.tpl、gateway/wist-gateway.toml.tpl）已移到 sys/configs/ 随库入库。
/configs/
# 栈根密钥文件（`WIST_GATEWAY_SEC_FILE` 默认指向 `.wist/sec-value.yml`；含 admin token，绝不入库）
/.wist/
/.galaxy/
# 同类目录的任何副本（`configs_x/` 等：同样是运行物，含 CA 私钥 / store，绝不入库）
/configs*/
# 站点身份（dev/prod **共用**）：CA / 证书 / 私钥 / 对外域名（`wist-gateway-pub.toml`）
# —— 现场生成、含私钥，绝不入库；契约/备份由 sys-prj.yml 声明。
/identity/
# 开发态网关 home（`dev/svc.sh` 生成：含 admin token / TLS 私钥 / CA / store —— 同发布态，绝不入库）
/dev/configs/
# gwlinkd **运行态**：`state_dir` 写成相对路径时的落点 —— 开发态 `dev/configs/gwlinkd/gwlinkd.toml`
# 就是 `state_dir = "state"`，从栈根起进程于是落在 `/state/`（单实例锁、升级簿记、注册凭据
# `identity` 里的 `ident_*` 与 instance id）。含凭据、可重建，绝不入库。
# 发布态的 `state_dir` 是绝对路径（`configs/gwlinkd/state`），已被上面的 `/configs/` 覆盖。
/state/
# 安装包投放目录（现场放 agent 安装包，只读挂给网关容器）
/packages/

# ===== gops 生成物 =====
# 变量解析结果（gops sys update / package 生成）
sys/resolved_vars.yml
# 交付锁（`gops sys package` 生成：version + generated_at + merged_vars/values 的哈希）。
# 不入库：它带时间戳，且哈希的是**当前**的 merged/values —— 提交进来就要每次发版重生一份，
# 否则很快就写成旧版本号 + 旧哈希（会漂、会撒谎）。它由 package 自己塞进交付包里（实测：
# 默认 `git ls-files` 模式下也会带上它），所以入库对交付没有增益。
/deliver.lock
# 值文件：忽略派生的值文件，保留客户覆盖 values/value.yml（版本化）
values/*
!values/value.yml
# .env 由 gops sys localize 生成（非密钥配置；密钥走 ${SEC_xxx} 不落盘）
.env

# 网关身份备份产物（含私钥，别入库）
wist-gateway-backup-*.tar.gz
wist-gateway-identity-*.tar.gz

# macOS
.DS_Store
.report
.run*
# 迁移（gops >= 1.4）：模块按目标模型分组
sys/*/mods
