name : auditd_record
rule : privilege_execution/privilege_execution_auditd_record
---
// 将 LOGRAW 中的 auditd 键值字段逐项映射；不同 type 实际提供的字段不同。
schema = read(schema);
agent = read(agent);
ts = read(ts);
seq = read(seq);
family = read(family);
unit = read(unit);
event_id = read(wp_event_id);
now = Now::time() | Time::to_ts_ms;
dev_ip = read(wp_src_ip);
tenant_id = chars(2092453428448002048);
dev_vendor = read(dev_vendor);
dev_name = read(dev_name);
dev_type = read(dev_type);
log_type = read(log_type);
log_desc = read(log_desc);
type = read(type);
msg = read(msg);
arch = read(arch);
syscall = read(syscall);
success = read(success);
exit = read(exit);
a0 = read(a0);
a1 = read(a1);
a2 = read(a2);
a3 = read(a3);
a4 = read(a4);
a5 = read(a5);
a6 = read(a6);
a7 = read(a7);
a8 = read(a8);
a9 = read(a9);
a10 = read(a10);
a11 = read(a11);
a12 = read(a12);
a13 = read(a13);
a14 = read(a14);
items = read(items);
ppid = read(ppid);
pid = read(pid);
auid = read(auid);
uid = read(uid);
gid = read(gid);
euid = read(euid);
suid = read(suid);
fsuid = read(fsuid);
egid = read(egid);
sgid = read(sgid);
fsgid = read(fsgid);
tty = read(tty);
ses = read(ses);
comm = read(comm);
exe = read(exe);
subj = read(subj);
key = read(key);
item = read(item);
name = read(name);
inode = read(inode);
dev = read(dev);
mode = read(mode);
ouid = read(ouid);
ogid = read(ogid);
rdev = read(rdev);
nametype = read(nametype);
cap_fp = read(cap_fp);
cap_fi = read(cap_fi);
cap_fe = read(cap_fe);
cap_fver = read(cap_fver);
cap_frootid = read(cap_frootid);
cwd = read(cwd);
argc = read(argc);
proctitle = read(proctitle);
